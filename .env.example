# ---------- Core ----------
PORT=8000
# Owner/"super user" number(s), digits only, comma separated. Works on every session.
OWNER_NUMBER=254111385747
OWNER_NAME=Freeezer
BOT_NAME=FREEEZER MD
PREFIX=.
# public | private | group | inbox  (default for new sessions; each session can change it)
MODE=public

# ---------- Storage ----------
# PostgreSQL / Supabase (recommended). Sessions + settings survive every restart.
# Use the Supabase "Connection pooling" URI; a special character in the password must be URL-encoded (? -> %3F).
DATABASE_URL=
# Alternative: MongoDB. Used only if DATABASE_URL is empty. Leave both empty to use local files (./sessions).
MONGODB_URI=

# ---------- Uptime ----------
# Public https URL of this app. The bot pings itself so free hosts never put it to sleep.
# (Render / Railway / Koyeb / Heroku are auto-detected.)
APP_URL=
KEEPALIVE_SECONDS=240

# ---------- Multi-session ----------
MAX_SESSIONS=50
# Dashboard / admin API token. If empty, the admin API is disabled.
ADMIN_TOKEN=change-me
# Allow anyone to request a pairing code from the website / .deploy command
PUBLIC_PAIRING=true
# Optional: only these numbers may pair (comma separated, digits only). Empty = anyone.
ALLOWED_NUMBERS=

# ---------- AI (any OpenAI-compatible API) ----------
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_SYSTEM=You are a helpful, concise WhatsApp assistant.

# ---------- Defaults for new sessions (true/false) ----------
AUTO_VIEW_STATUS=false
AUTO_LIKE_STATUS=false
ANTI_DELETE=false
ANTI_CALL=false
ANTI_SPAM=true
WARN_LIMIT=3
WELCOME_ENABLE=false
GOODBYE_ENABLE=false
